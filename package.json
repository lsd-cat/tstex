{
  "name": "tstex",
  "version": "0.1.0",
  "description": "pdfLaTeX in pure TypeScript",
  "license": "GPL-3.0-or-later",
  "author": "lsd-cat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsd-cat/tstex.git"
  },
  "homepage": "https://lsd-cat.github.io/tstex/",
  "bugs": {
    "url": "https://github.com/lsd-cat/tstex/issues"
  },
  "keywords": [
    "tex",
    "latex",
    "pdflatex",
    "pdftex",
    "typesetting",
    "pdf",
    "browser",
    "wasm-free"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist-node/src/node.js",
      "default": "./dist/index.js"
    },
    "./worker": "./dist/worker.js"
  },
  "bin": {
    "tstex": "dist-node/bin/tstex.js"
  },
  "files": [
    "dist",
    "dist-node",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.browser.json && tsc -p tsconfig.node.json && cp tools/minimal-files.txt dist-node/tools/",
    "test": "node --test test/oracle/ test/unit/",
    "test:lvt": "node --test test/lvt/",
    "corpus": "node tools/corpus.ts",
    "test:browser": "node --test test/browser/",
    "test:demo": "node --test test/browser/demo.test.ts",
    "pack": "node tools/pack-texmf.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && node --test test/unit/"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright": "^1.65.0",
    "typescript": "latest"
  },
  "sideEffects": false
}
